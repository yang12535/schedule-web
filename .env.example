# ========================================
# 班级课表服务 - 环境配置示例
# 复制为 .env 后修改
# ========================================

# 基础配置
CLASS_NAME=计算机网络1班
CLASS_DESC=当前学期
SEMESTER_START=2026-03-01

# 安全设置
# 公网部署必须设置强密码。删除整行可让服务在每次容器创建时自动生成密码。
# 只有显式设置为空字符串才会关闭密码保护，不建议在任何公网环境使用。
# EDIT_PASSWORD=请替换为至少8位强密码
# 设置固定密码后可改为 false；自动生成时保持 true 才能从首次启动日志查看密码。
PRINT_EDIT_PASSWORD=true

# 服务端口（Docker部署使用）
HOST_PORT=30080

# 数据存储路径（相对于 docker-compose.yml）
DATA_PATH=./data
